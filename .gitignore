# ============================================================
# .gitignore estándar para proyectos HTML / Frontend
# ============================================================

# ---------------------------
# Dependencias
# ---------------------------
node_modules/
bower_components/
jspm_packages/

# ---------------------------
# Archivos de entorno
# ---------------------------
.env
.env.local
.env.*.local
.env.development
.env.production

# ---------------------------
# Build / Distribución
# ---------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.vite/

# ---------------------------
# Editores e IDEs
# ---------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ---------------------------
# Sistema operativo
# ---------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ---------------------------
# Logs
# ---------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------
# Archivos temporales
# ---------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---------------------------
# Minificados locales (generados)
# ---------------------------
*.min.js
*.min.css

# ---------------------------
# Cobertura de tests
# ---------------------------
coverage/
.nyc_output/

# ---------------------------
# Misc
# ---------------------------
*.zip
*.tar.gz
*.rar
